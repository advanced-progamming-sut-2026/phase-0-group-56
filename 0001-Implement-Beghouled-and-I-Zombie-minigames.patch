+            PlantCategory categoryToLock = lock;
+            if (categoryToLock != null) {
+                selection.getPlantsToChoose().removeIf(
+                    plant -> plant.getCategory().equals(categoryToLock)
+                );
+            }
         }
         return super.startGame(plantName);
 
