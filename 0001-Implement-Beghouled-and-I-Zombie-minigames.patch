@@ -0,0 +1,72 @@
+package view.gameview;
+
+import com.badlogic.gdx.Gdx;
+import com.badlogic.gdx.files.FileHandle;
+
+import java.io.File;
+import java.util.ArrayList;
+import java.util.List;
+
+/** Locates the extracted PvZ asset root without assuming one IDE working directory. */
+public final class PvzAssetLocator {
+    private PvzAssetLocator() {
+    }
+
+    public static FileHandle find() {
+        List<FileHandle> candidates = new ArrayList<>();
+        String configured = System.getProperty("pvz.assets");
+        if (configured != null && !configured.isBlank()) {
+            candidates.add(new FileHandle(new File(configured)));
+        }
+
+        String[] paths = {
+            "Assets",
+            "../Assets",
+            "../../Assets",
+            "pvz-assets",
+            "../pvz-assets",
+            "../../pvz-assets"
+        };
+        for (String path : paths) {
+            candidates.add(new FileHandle(new File(path)));
+        }
+        candidates.add(Gdx.files.internal("pvz-assets"));
+
+        for (FileHandle candidate : candidates) {
+            FileHandle root = resolve(candidate);
+            if (root != null) {
+                return root;
+            }
+        }
+        return null;
+    }
+
+    private static FileHandle resolve(FileHandle candidate) {
+        if (candidate == null || !candidate.exists()) {
+            return null;
+        }
+        if (isRoot(candidate)) {
+            return candidate;
+        }
+
+        String[] children = {"Base Assets", "base assets", "BaseAssets", "assets"};
+        for (String childName : children) {
+            FileHandle child = candidate.child(childName);
+            if (isRoot(child)) {
+                return child;
+            }
+        }
+        return null;
+    }
+
+    private static boolean isRoot(FileHandle root) {
+        if (root == null || !root.exists()) {
+            return false;
+        }
+        boolean resources = root.child("resources.json").exists()
+            || root.child("RESOURCES.json").exists();
+        boolean atlases = root.child("atlases").exists()
+            || root.child("ATLASES").exists();
+        return resources && atlases;
+    }
+}
diff --git a/pvz2/core/src/test/java/models/games/minigames/MinigameModelSmokeTest.java b/pvz2/core/src/test/java/models/games/minigames/MinigameModelSmokeTest.java
new file mode 100644
index 0000000..067bab9
--- /dev/null
+++ b/pvz2/core/src/test/java/models/games/minigames/MinigameModelSmokeTest.java
@@ -0,0 +1,139 @@
+package models.games.minigames;
+
+import com.badlogic.gdx.files.FileHandle;
+import com.badlogic.gdx.utils.Json;
+import controllers.datacontroller.Data;
+import controllers.datacontroller.PlantData;
+import models.App;
+import models.User;
+import models.entity.Zombie;
+import models.factory.PlantFactory;
+import models.factory.builder.PlantType;
+
+import java.lang.reflect.Field;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.Locale;
+import java.util.Set;
+
+/** Standalone model smoke tests; run with assertions enabled. */
+public final class MinigameModelSmokeTest {
+    private MinigameModelSmokeTest() {
+    }
+
+    public static void main(String[] args) throws Exception {
+        installPlantData();
+        App.setCurrentuser(new User("test", "hash", "tester", "test@example.com", "x"));
+        check(new PlantFactory().createPlant(PlantType.FUM_SHROOM) != null,
+            "Beghouled's FUM_SHROOM upgrade must be constructible.");
+
+        testBeghouledBoardAndSwap();
+        testIZombieConfigurationAndWin();
+        testZombieRowZero();
+        System.out.println("Minigame model smoke tests passed.");
+    }
+
+    private static void testBeghouledBoardAndSwap() {
+        Beghouled game = new Beghouled(2);
+        check(game.getPlantsInField().size() == 45, "Beghouled must fill all 45 tiles.");
+        check(game.hasValidMove(), "Beghouled must start with a legal move.");
+
+        boolean matched = false;
+        for (int row = 0; row < Beghouled.ROW_COUNT && !matched; row++) {
+            for (int column = 0; column < Beghouled.COLUMN_COUNT && !matched; column++) {
+                if (column + 1 < Beghouled.COLUMN_COUNT) {
+                    matched = game.swap(column, row, column + 1, row)
+                        == Beghouled.SwapResult.MATCHED;
+                }
+                if (!matched && row + 1 < Beghouled.ROW_COUNT) {
+                    matched = game.swap(column, row, column, row + 1)
+                        == Beghouled.SwapResult.MATCHED;
+                }
+            }
+        }
+
+        check(matched, "At least one advertised Beghouled move must create a match.");
+        check(game.getPlantsInField().size() == 45, "Cascades must refill the board.");
+        check(game.getSunCount() > 0, "Matches must award upgrade sun.");
+        check(game.getScore() > 0, "Matches must award score.");
+    }
+
+    private static void testIZombieConfigurationAndWin() {
+        Set<String> allTypes = new HashSet<>();
+        for (int level = 1; level <= 3; level++) {
+            IZombie configured = new IZombie(level);
+            check(configured.getZombieCards().size() == 5, "Every I, Zombie level needs five cards.");
+            configured.getZombieCards().forEach(card -> allTypes.add(card.type()));
+        }
+        check(allTypes.size() >= 10, "I, Zombie needs at least ten distinct zombies across levels.");
+
+        IZombie game = new IZombie(1);
+        check(game.getSunCount() == IZombie.STARTING_SUN, "I, Zombie must start with 150 sun.");
+        check(game.getSunProducers().size() == 5, "One producer is required in every row.");
+        game.setSunCount(1000);
+
+        for (int row = 0; row < IZombie.ROW_COUNT; row++) {
+            String type = game.getZombieCards().get(0).type();
+            IZombie.PlacementResult result = game.placeZombie(
+                type,
+                IZombie.FIRST_ZOMBIE_COLUMN,
+                row
+            );
+            check(result == IZombie.PlacementResult.PLACED, "A funded valid placement must work.");
+            Zombie deployed = findDeployedZombie(game, row);
+            check(deployed != null, "Placed zombie must enter the active list.");
+            deployed.setX(0f);
+        }
+
+        game.playGame(0f);
+        check(game.isWonGame(), "Eating all five brains must win I, Zombie.");
+    }
+
+    private static Zombie findDeployedZombie(IZombie game, int row) {
+        for (Zombie zombie : game.getZombies()) {
+            if (!game.isSunProducer(zombie) && zombie.getLine() == row) {
+                return zombie;
+            }
+        }
+        return null;
+    }
+
+    private static void testZombieRowZero() {
+        Zombie zombie = models.factory.ZombieFactory.createZombie("normal");
+        zombie.setLine(0);
+        check(zombie.getLine() == 0, "Zombie row zero must remain row zero.");
+    }
+
+    @SuppressWarnings("unchecked")
+    private static void installPlantData() throws Exception {
+        Json json = new Json();
+        json.setIgnoreUnknownFields(true);
+        ArrayList<PlantData> list = json.fromJson(
+            ArrayList.class,
+            PlantData.class,
+            new FileHandle("assets/plants.json")
+        );
+
